{
  "name": "reti-ghost-sdk",
  "version": "0.3.0-dt.6",
  "description": "Read-only SDK for the Reti staking registry, with reads at any past round on a dtalgorand node, through read-only queries when the node has them",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d13co/reti-ghost-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/d13co/reti-ghost-sdk/issues"
  },
  "homepage": "https://github.com/d13co/reti-ghost-sdk/tree/dtalgorand/projects/sdk#readme",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "tag": "dt"
  },
  "scripts": {
    "prebuild": "cp ../contracts/smart_contracts/artifacts/reti_reader/RetiReaderSDK.ts src/generated && node scripts/strip-app-spec-source.mjs src/generated/RetiReaderSDK.ts",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:dist-pkg",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:dist-pkg": "node scripts/write-dist-package-json.mjs",
    "prepublishOnly": "node scripts/check-publish-tag.mjs && pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "algorand",
    "reti",
    "staking",
    "ghostkit",
    "dtalgorand",
    "time-travel",
    "query"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "peerDependencies": {
    "@algorandfoundation/algokit-utils": ">=9.2.0",
    "algosdk": ">=3.5.2"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-utils": "file:../../vendor/d13co-dt-algokit-utils-9.2.3-dt.2.0.1.0.tgz",
    "@types/node": "^25.0.3",
    "algosdk": "file:../../vendor/dtalgosdk-3.9.0-dt.2.0.1.0.tgz",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "3.2.4"
  }
}
