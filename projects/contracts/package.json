{
  "name": "smart_contracts",
  "version": "1.0.0",
  "description": "Smart contract deployer",
  "main": "smart_contracts/index.ts",
  "scripts": {
    "build": "puya-ts smart_contracts --out-dir artifacts && pnpm exec ghostkit build smart_contracts/artifacts/reti_reader/RetiReader.arc56.json && pnpm exec ghostkit build smart_contracts/artifacts/reti_query_reader/RetiQueryReader.arc56.json",
    "deploy": "ts-node-dev --transpile-only --watch .env -r dotenv/config smart_contracts/index.ts",
    "deploy:ci": "ts-node --transpile-only -r dotenv/config smart_contracts/index.ts",
    "check-types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0",
    "npm": ">=9.0"
  },
  "dependencies": {
    "@algorandfoundation/algorand-typescript": "^1.3.1"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^6.0.0",
    "@algorandfoundation/algokit-utils": "npm:@d13co/dt-algokit-utils@9.2.3-dt.5.2.0.0",
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/puya-ts": "^1.3.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^25.0.3",
    "algosdk": "npm:dt-algosdk@3.9.0-dt.5.2.0.0",
    "dotenv": "^16.4.7",
    "ghostkit": "0.1.0-dt.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
